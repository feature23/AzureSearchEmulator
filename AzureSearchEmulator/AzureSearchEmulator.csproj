<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<UserSecretsId>6751dc28-24d4-4572-8f44-e652593dd678</UserSecretsId>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>1.0.0-beta.4</Version>
		<WarningsAsErrors>Nullable</WarningsAsErrors>
		<LangVersion>14</LangVersion>
		<IsPackable>true</IsPackable>
		<PackAsTool>true</PackAsTool>
		<ToolCommandName>azsearchemu</ToolCommandName>
		<PackageId>AzureSearchEmulator</PackageId>
		<PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
		<RepositoryUrl>https://github.com/feature23/azuresearchemulator</RepositoryUrl>
		<PackageTags>azure search emulator ai cognitive-search</PackageTags>
		<Description>A local emulator for Azure AI Search, runnable as a .NET tool.</Description>
		<Company>feature[23]</Company>
		<Copyright>Copyright (c) feature[23] 2025</Copyright>
		<Authors>Paul Irwin</Authors>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<!-- Blazor's own script (blazor.web.js) ships in a package the SDK only adds when it sees
		     .razor files at restore time. The Dockerfile restores from the project file alone, before
		     the sources are copied in, so the image was published without the script: the dashboard
		     prerendered but never went interactive, and the search page stayed blank (issue #92). -->
		<RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Azure.Search.Documents" Version="12.0.0" />
		<PackageReference Include="Lucene.Net" Version="4.8.0-beta00017" />
		<PackageReference Include="Lucene.Net.Analysis.Common" Version="4.8.0-beta00017" />
		<PackageReference Include="Lucene.Net.Highlighter" Version="4.8.0-beta00017" />
		<PackageReference Include="Lucene.Net.Queries" Version="4.8.0-beta00017" />
		<PackageReference Include="Lucene.Net.QueryParser" Version="4.8.0-beta00017" />
		<PackageReference Include="Lucene.Net.Spatial" Version="4.8.0-beta00017" />
		<PackageReference Include="Microsoft.AspNetCore.OData" Version="9.5.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
		<PackageReference Include="System.Numerics.Tensors" Version="10.0.11" />
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="indexes\" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="../logo.png" Pack="true" PackagePath="\" />
	  <None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
